<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="#241A66">
    <TextView android:id="@+id/widget_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="16sp" android:maxLines="1" android:ellipsize="end" android:text="正计时" />
    <TextView android:id="@+id/widget_elapsed" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="#8FF5D4" android:textSize="22sp" android:textStyle="bold" android:text="0天 00:00:00" />
    <TextView android:id="@+id/widget_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#DAD4FF" android:textSize="12sp" android:text="正在累计" />
</LinearLayout>
